# Tee's House — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# ── Sanity CMS ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=zbeb0ctt
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Read token — from sanity.io/manage → project → API → Tokens
SANITY_API_TOKEN=

# ── Supabase ────────────────────────────────────────────────────────────────
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (email) ──────────────────────────────────────────────────────────
# From resend.com → API Keys
RESEND_API_KEY=

# Email address that receives form submission notifications
NOTIFICATION_EMAIL=info@teeshouse.org

# ── Sanity Webhook Cache Revalidation ───────────────────────────────────────
# Must match the secret in your Sanity webhook URL.
# Generate with: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# ── PayPal ──────────────────────────────────────────────────────────────────
# Full PayPal donation link (optional — can also be set in Sanity Site Settings)
NEXT_PUBLIC_PAYPAL_DONATE_URL=
